{
  "name": "examflow",
  "version": "1.0.0",
  "private": true,
  "workspaces": [
    "apps/web",
    "apps/api"
  ],
  "scripts": {
    "dev": "concurrently -k -n web,api -c blue,green \"npm:dev:web\" \"npm:dev:api\"",
    "dev:web": "npm run dev --workspace apps/web",
    "dev:api": "npm run dev --workspace apps/api",
    "build": "npm run build --workspace apps/web && npm run build --workspace apps/api",
    "build:java": "mvn -f services/java-socket-server/pom.xml clean package",
    "test:java": "mvn -f services/java-socket-server/pom.xml test",
    "build:all": "npm run build && npm run build:java",
    "test": "npm run test --workspace apps/api",
    "test:realtime": "npm run test:realtime --workspace apps/api",
    "test:outage": "node --test apps/api/src/realtime/outage.integration.test.js",
    "test:browser": "node scripts/browser-audit.mjs",
    "test:question-form": "node --test scripts/question-form.test.mjs",
    "start:web": "npm run preview --workspace apps/web",
    "start:local": "powershell.exe -NoProfile -File scripts/start-local.ps1",
    "start:api": "npm run start --workspace apps/api",
    "start:java": "dotenv -e .env -- mvn -f services/java-socket-server/pom.xml compile exec:java -Dexec.mainClass=lk.examflow.socket.SocketServer",
    "start:all": "concurrently -k -n web,api,java -c blue,green,yellow \"npm:dev:web\" \"npm:dev:api\" \"npm:start:java\""
  },
  "devDependencies": {
    "@playwright/test": "^1.65.0",
    "concurrently": "^9.2.1",
    "dotenv-cli": "^8.0.0"
  }
}
